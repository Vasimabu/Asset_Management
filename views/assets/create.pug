extends ../layouts/layout
block content
  section.page-header
    h2 Add asset
    p Register a uniquely identifiable company asset.
  section.panel.form-panel
    form#assetForm
      .form-grid
        label Asset ID
          input(name="asset_id" required maxlength="30" placeholder="e.g. LAP-0001")
        label Asset name
          input(name="asset_name" required)
        label Serial number
          input(name="serial_number" required)
        label Category
          select(name="category_id" required)#assetCategorySelect
        label Make
          input(name="make")
        label Model
          input(name="model")
        label Purchase date
          input(type="date" name="purchase_date")
        label Purchase cost
          input(type="number" name="purchase_cost" min="0" step="0.01")
        label Branch ID
          input(name="branch_id" required placeholder="Branch UUID")
        label Status
          select(name="status")
            option(value="AVAILABLE") Available
            option(value="REPAIR") Repair
      .form-actions
        a.btn.secondary(href="/assets") Cancel
        button.btn.primary(type="submit") Save asset
  script(src="/js/asset.js")

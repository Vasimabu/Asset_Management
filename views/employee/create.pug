extends ../layouts/layout
block content
  link(rel="stylesheet" href="/css/employee.css")
  .container-fluid.px-0
    h2.mb-4 Add Employee
    .card.shadow-sm.form-card
      .card-body
        form#employeeForm.needs-validation(novalidate)
          .row.g-3
            each f in [{n:'employee_code',l:'Employee code',t:'text'},{n:'first_name',l:'First name',t:'text'},{n:'last_name',l:'Last name',t:'text'},{n:'email',l:'Email',t:'email'},{n:'mobile',l:'Mobile',t:'tel'},{n:'designation',l:'Designation',t:'text'},{n:'branch_id',l:'Branch ID',t:'text'}]
              .col-md-6
                label.form-label(for=f.n)= f.l
                if f.n === 'branch_id'
                  select.form-select#branch_id(name="branch_id" required)
                    option(value="") Select a branch
                else
                  input.form-control(id=f.n type=f.t name=f.n required=(f.n === 'employee_code' || f.n === 'first_name'))
            .col-md-6
              label.form-label(for="status") Status
              select#status.form-select(name="status")
                option(value="ACTIVE") Active
                option(value="INACTIVE") Inactive
          .mt-4.d-flex.gap-2
            button.btn.btn-primary(type="submit") Save Employee
            a.btn.btn-light(href="/employees") Cancel
  script(src="/js/employee.js")